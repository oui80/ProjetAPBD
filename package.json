{
  "name": "pace-lab",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "build": "yarn workspace @pace-lab/backend build && yarn workspace @pace-lab/frontend build",
    "build:bounded": "NODE_OPTIONS=\"${NODE_OPTIONS:---max-old-space-size=1024}\" yarn build",
    "build:backend": "yarn workspace @pace-lab/backend build",
    "build:frontend": "yarn workspace @pace-lab/frontend build",
    "dev:backend": "yarn workspace @pace-lab/backend dev",
    "dev:frontend": "yarn workspace @pace-lab/frontend dev",
    "lint": "eslint backend/src backend/test frontend/src",
    "lint:backend": "eslint backend/src backend/test",
    "lint:frontend": "eslint frontend/src",
    "lint:files": "eslint",
    "test": "yarn workspace @pace-lab/backend test && yarn workspace @pace-lab/frontend test",
    "test:backend": "yarn workspace @pace-lab/backend test --maxWorkers=1 --minWorkers=1",
    "test:frontend": "yarn workspace @pace-lab/frontend test --maxWorkers=1 --minWorkers=1",
    "typecheck:backend": "yarn workspace @pace-lab/backend typecheck",
    "typecheck:frontend": "yarn workspace @pace-lab/frontend typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.72.0"
  }
}
