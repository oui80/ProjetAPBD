{
  "name": "pace-lab",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "build": "yarn workspace @pace-lab/backend build && yarn workspace @pace-lab/frontend build",
    "dev:backend": "yarn workspace @pace-lab/backend dev",
    "dev:frontend": "yarn workspace @pace-lab/frontend dev",
    "lint": "eslint backend/src backend/test frontend/src",
    "test": "yarn workspace @pace-lab/backend test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.72.0"
  }
}
